en(train)>=12 else train.iloc[-1])\\n        return np.array(vals)\\n    if method=='snaive_drift':\\n        # seasonal naive plus average annual drift over existing same months\\n        vals=[]\\n        years=(len(train)-12)/12\\n        drift=(train.iloc[-1]-train.iloc[11])/max(1, years) if len(train)>24 else 0\\n        for h in range(1, steps+1): vals.append(train.iloc[-12+h-1] + h*drift/12)\\n        return np.array(vals)\\n    if method=='ets_add':\\n        fit=ExponentialSmoothing(train, trend='add', seasonal='add', seasonal_periods=12, initialization_method='estimated').fit(optimized=True)\\n        return np.asarray(fit.forecast(steps))\\n    if method=='ets_mul':\\n        fit=ExponentialSmoothing(train, trend='add', seasonal='mul', seasonal_periods=12, initialization_method='estimated').fit(optimized=True)\\n        return np.asarray(fit.forecast(steps))\\n    if method=='sarima1':\\n        fit=SARIMAX(train, order=(0,1,1), seasonal_order=(0,1,1,12), trend='n', enforce_stationarity=False, enforce_invertibility=False).fit(disp=False)\\n        return np.asarray(fit.forecast(steps))\\n    if method=='sarima2':\\n        fit=SARIMAX(train, order=(1,0,0), seasonal_order=(1,0,0,12), trend='c', enforce_stationarity=False, enforce_invertibility=False).fit(disp=False)\\n        return np.asarray(fit.forecast(steps))\\n    if method=='linear_month':\\n        # sklearn linear regression with trend + month dummies; quick closed form with pandas/numpy\\n        t=np.arange(len(train))\\n        X=pd.get_dummies(train.index.month.astype(str), drop_first=True)\\n        X=pd.concat([pd.Series(t,index=train.index,name='t'), X.set_index(train.index)], axis=1)\\n        X=np.column_stack([np.ones(len(train)), X.values.astype(float)])\\n        beta=np.linalg.lstsq(X, train.values, rcond=None)[0]\\n        future_idx=pd.date_range(train.index[-1]+pd.offsets.MonthBegin(1), periods=steps, freq='MS')\\n        tf=np.arange(len(train), len(train)+steps)\\n        Xf=pd.get_dummies(future_idx.month.astype(str), drop_first=True)\\n        # align dummy columns to train dummies\\n        cols=pd.get_dummies(train.index.month.astype(str), drop_first=True).columns\\n        Xf=Xf.reindex(columns=cols, fill_value=0)\\n        Xf=np.column_stack([np.ones(steps), tf, Xf.values.astype(float)])\\n        return Xf.dot(beta)\\n\\nmethods=['seasonal_naive','snaive_drift','ets_add','ets_mul','sarima1','sarima2','linear_month']\\n# rolling CV: forecast 1-3 month ahead for origins from at least 24 obs, evaluate target h=3 maybe and all horizons.\\ncv=[]\\nfor m in methods:\\n    errs=[]; errs_h3=[]\\n    preds=[]\\n    for end in range(24, len(y)-2): # train up to end-1, forecast 3, target end+2\\n        train=y.iloc[:end]\\n        actual=y.iloc[end:end+3].values\\n        try:\\n            fc=fit_forecast(m, train, 3)\\n            errs.extend(actual-fc)\\n            errs_h3.append(actual[2]-fc[2])\\n        except Exception as e:\\n            pass\\n    if errs:\\n        cv.append({'method':m,'nerr':len(errs),'MAE_all':np.mean(np.abs(errs)),'RMSE_all':np.sqrt(np.mean(np.array(errs)**2)),'MAE_h3':np.mean(np.abs(errs_h3)) if errs_h3 else np.nan,'bias_all':np.mean(errs)})\\nprint('\\\\nCV')\\nprint(pd.DataFrame(cv).sort_values('MAE_all').to_string(index=False))\\n\\n# final forecasts\\nfinal=[]\\nfor m in methods:\\n    try:\\n        fc=fit_forecast(m, y, 3)\\n        final.append({'method':m,'Jan26':fc[0], 'Feb26':fc[1], 'Mar26':fc[2]})\\n    except Exception as e:\\n        final.append({'method':m,'error':str(e)})\\nprint('\\\\nFinal method forecasts')\\nprint(pd.DataFrame(final).to_string(index=False))\\n\\n# Main model: ensemble weighting inverse CV MAE_all or h3 among top robust. Compute interval from rolling h=3 errors of chosen ensemble.\\n# Build ensemble of top 4 by CV: seasonal_naive, ets? Use inverse RMSE weights for methods that work.\\ncvdf=pd.DataFrame(cv).set_index('method')\\n# exclude unstable sarima if weird forecasts? We'll see. Use top 4 by MAE_all, maybe cap point plausible.\\ntop=cvdf.sort_values('MAE_all').head(4).index.tolist()\\nprint('top', top)\\nfinaldf=pd.DataFrame(final).set_index('method')\\nweights=1/cvdf.loc[top,'RMSE_all']\\nweights=weights/weights.sum()\\npoint=float((finaldf.loc[top,'Mar26']*weights).sum())\\nprint('ensemble weights', weights.to_dict(), 'point', point)\\n\\n# rolling ensemble h3 residuals with same top weights fixed? Forecast each origin and blend with current weights (normalize available)\\nres=[]\\nfor end in range(24, len(y)-2):\\n    actual=y.iloc[end+2]\\n    fcs=[]; ws=[]\\n    for m in top:\\n        try:\\n            fcs.append(fit_forecast(m, y.iloc[:end], 3)[2]); ws.append(weights[m])\\n        except: pass\\n    if fcs:\\n        ws=np.array(ws)/np.sum(ws); fc=float(np.dot(ws, fcs)); res.append(actual-fc)\\nres=np.array(res)\\nprint('ensemble h3 residuals', len(res), 'MAE', np.mean(np.abs(res)), 'RMSE', np.sqrt(np.mean(res**2)), 'bias', np.mean(res), 'q05q95', np.quantile(res,[.05,.95]))\\n# interval: point + empirical residual quantiles, but small CV n. Also use RMSE normal 1.645*rmse. Compare.\\nlo_emp, hi_emp = point + np.quantile(res,[.05,.95])\\nrmse=np.sqrt(np.mean(res**2))\\nlo_norm, hi_norm = point - 1.645*rmse, point + 1.645*rmse\\nprint('Intervals emp', lo_emp, hi_emp, 'norm', lo_norm, hi_norm)\\n\\n# Additional diagnostics: trend and March YoY\\nprint('\\\\nYoY by month 2025 vs 2024')\\nyoy=[]\\nfor m in range(1,13):\\n    try:\\n        v25=df[(df.period_year==2025)&(df.period_month==m)]['sales_units'].iloc[0]\\n        v24=df[(df.period_year==2024)&(df.period_month==m)]['sales_units'].iloc[0]\\n        yoy.append({'month':m,'yoy_pct':(v25/v24-1)*100,'diff':v25-v24})\\n    except: pass\\nprint(pd.DataFrame(yoy).to_string(index=False))\\n# YTD Q1 totals\\nfor yr in [2023,2024,2025]:\\n    q1=df[(df.period_year==yr)&(df.period_month.isin([1,2,3]))]['sales_units'].sum()\\n    print('Q1',yr,q1)\\n\\n\"}",
