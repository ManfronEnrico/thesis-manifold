s']].tail().to_string())\\nprint('n', len(df), 'from', df.index.min(), 'to', df.index.max())\\nprint('Mar values')\\nprint(df[df.period_month==3][['period_year','sales_units']].to_string(index=False))\\nprint('YoY Mar growth', df[df.period_month==3].sales_units.pct_change().to_list())\", \"images_in_system_message\": false}",
