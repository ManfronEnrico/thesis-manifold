# =============================================================================
# .env.example — Environment variable template
# Copy this file to .env and fill in the values.
# .env is in .gitignore and must NEVER be committed to git.
# Share the actual .env values directly with collaborators (e.g. Signal/WhatsApp).
# =============================================================================

# ── Nielsen / Prometheus Database (Azure AD Service Principal) ────────────────
RU_SERVER_STRING=
RU_DATABASE=
RU_CLIENT_ID=
RU_TENANT_ID=
RU_CLIENT_SECRET=

# ── Anthropic API ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── NotebookLM (optional — for CI/CD auth without browser) ────────────────────
# Leave blank if using interactive `notebooklm login` (recommended for thesis work).
# Populate with JSON from ~/.notebooklm/storage_state.json if needed for scripted runs.
NOTEBOOKLM_AUTH_JSON=
