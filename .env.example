# =============================================================================
# .env.example — Environment variable template
# Copy this file to .env and fill in the values.
# .env is in .gitignore and must NEVER be committed to git.
# Share the actual .env values directly with collaborators (e.g. Signal/WhatsApp).
# =============================================================================

# ── Nielsen / Prometheus Database (Azure AD Service Principal) ────────────────
RU_SERVER_STRING=
RU_DATABASE=
RU_CLIENT_ID=
RU_TENANT_ID=
RU_CLIENT_SECRET=


# ── OpenAI API ─────────────────────────────────────────────────────────────
# For the LLM Model gpt-5.5-2026-04-23 that is the Agent for all Experiment Scenarios. 
thesis_manifold_openai_prompts=
thesis_manifold_openai_prompts_admin=


# ── E2B Sandbox API ─────────────────────────────────────────────────────────────
# Instantiating the Sandbox for the Promotheus Engines Code Executions
thesis_manifold_e2b_sandbox=

# E2B sandbox template for the Prometheus graph engine (P0044 F22).
# Registered to this account as alias 'prometheus' (id fxe7gzkqjupdhbx4uvpr,
# 4096 MB, private). WITHOUT this, AsyncSandbox.create(None, ...) silently
# falls back to E2B's default base image, which has no pyodbc -- so warehouse
# queries fail INSIDE the sandbox rather than at connection time.
PROMETHEUS_TEMPLATE_ID=prometheus