  series = {29th International Conference on Knowledge-Based and Intelligent Information & Engineering Systems (KES 2025)},
  libraryCatalog = {ScienceDirect}
}

@journalArticle{K9IHQTWG,
  title = {Decision-Focused Learning: Foundations, State of the Art, Benchmark and Future Opportunities},
